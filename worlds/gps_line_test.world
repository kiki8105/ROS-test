<?xml version="1.0"?>
<sdf version="1.6">
  <world name="gps_line_test_world">

    <!-- 바닥 -->
    <!-- 외부 모델 조회 없이 시작하도록 바닥과 태양광을 월드에 직접 정의 -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- GPS ENU 원점: hybrid_localizer.yaml datum과 같은 값 -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>37.5665</latitude_deg>
      <longitude_deg>126.9780</longitude_deg>
      <elevation>38.0</elevation>
      <heading_deg>180.0</heading_deg>
    </spherical_coordinates>

    <scene>
      <shadows>false</shadows>
    </scene>

    <!-- 위에서 내려다보는 초기 시점 -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.319654 -0.235002 9.29441 0 1.5138 0.009599</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>

      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>

        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- 폭 10cm의 빨간색 정육각형 라인 -->
    <model name="red_hexagon">
      <static>true</static>

      <!-- 육각형 전체의 위치와 회전 -->
      <pose>0 0 0.005 0 0 0</pose>

      <link name="line_link">

        <!-- 위쪽 가로선 -->
        <visual name="top">
          <pose>0 1.299038 0 0 0 0</pose>
          <geometry>
            <box>
              <size>1.56 0.1 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>

        <!-- 오른쪽 위: -60도 -->
        <visual name="upper_right">
          <pose>1.125 0.649519 0 0 0 -1.047198</pose>
          <geometry>
            <box>
              <size>1.56 0.1 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>

        <!-- 오른쪽 아래: +60도 -->
        <visual name="lower_right">
          <pose>1.125 -0.649519 0 0 0 1.047198</pose>
          <geometry>
            <box>
              <size>1.56 0.1 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>

        <!-- 아래쪽 가로선 -->
        <visual name="bottom">
          <pose>0 -1.299038 0 0 0 0</pose>
          <geometry>
            <box>
              <size>1.56 0.1 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>

        <!-- 왼쪽 아래: -60도 -->
        <visual name="lower_left">
          <pose>-1.125 -0.649519 0 0 0 -1.047198</pose>
          <geometry>
            <box>
              <size>1.56 0.1 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>

        <!-- 왼쪽 위: +60도 -->
        <visual name="upper_left">
          <pose>-1.125 0.649519 0 0 0 1.047198</pose>
          <geometry>
            <box>
              <size>1.56 0.1 0.002</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
          <cast_shadows>false</cast_shadows>
        </visual>

      </link>
    </model>

  </world>
</sdf>